{
    "configurations": [
        {
            "name": "OpenCilk",
            "compilerPath": "/usr/bin/gcc",
            "intelliSenseMode": "clang-x64",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/local/opencilk/lib/clang/16/include/"
            ],
            "defines": [
                "__cilk__"
            ],
            "cStandard": "c11",
            "cppStandard": "c++17",
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "/usr/local/opencilk/lib/clang/16/include"
                ],
                "limitSymbolsToIncludedHeaders": false
            }
        },
        {
            "name": "OpenMP",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/lib/gcc/x86_64-linux-gnu/11/include/"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "${default}"
        }
    ],
    "version": 4
}