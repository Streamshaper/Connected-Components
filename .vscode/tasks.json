{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build with GCC",
            "type": "shell",
            "command": "/usr/bin/gcc",
            "args": [
                "-fopenmp",
                "-g",
                "${workspaceFolder}/*.c",
                "-o",
                "${workspaceFolder}/cc",
                "-lm",
                "-lmatio"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}