{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build with OpenCilk",
            "type": "shell",
            "command": "/usr/local/opencilk/bin/clang",
            "args": [
                "-fopencilk",
                "-fcilktool=cilkscale",
                "-g",
                "${workspaceFolder}/*.c",
                "-o",
                "${workspaceFolder}/cc",
                "-lm",
                "-lmatio"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}