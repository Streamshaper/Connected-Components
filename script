#!/bin/bash

if [ $# -lt 2 ]; then
    echo "Usage: $0 <program> <num_runs>"
    exit 1
fi

prog="$1"
runs="$2"

sum=0

for ((i=1; i<=runs; i++)); do
    raw=$("$prog")                 # get output like "1.402573,"
    value=$(echo "$raw" | tr -d ',')   # remove comma
    sum=$(echo "$sum + $value" | bc -l)
done

average=$(echo "$sum / $runs" | bc -l)

printf "Total: %.3f\n" "$sum"
printf "Average: %.3f\n" "$average"
